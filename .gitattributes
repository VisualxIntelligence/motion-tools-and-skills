# Normalise line endings (the working copy lives on Windows)
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.glb binary
*.gltf -diff
*.blend binary
*.uasset binary
*.umap binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
