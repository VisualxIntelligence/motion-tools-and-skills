 "lines": [
  {
   "start": 0.17,
   "end": 2.66,
   "text": "How long does it take to get to the moon, Mars, or Jupiter?"
  },
  {
   "start": 3.33,
   "end": 3.89,
   "text": "It depends."
  },
  {
   "start": 4.36,
   "end": 8.67,
   "text": "The fastest Apollo mission, Apollo 8, took just under three days to reach the moon."
  },
  {
   "start": 9.26,
   "end": 12.14,
   "text": "Mars is about 50% further from the sun than Earth is."
  },
  {
   "start": 12.62,
   "end": 14.53,
   "text": "Getting there takes seven to ten months."
  },
  {
   "start": 15.27,
   "end": 18.64,
   "text": "NASA's Mars Reconnaissance Orbiter took about seven and a half months."
  },
  {
   "start": 19.47,
   "end": 20.54,
   "text": "Maven took about ten."
  },
  {
   "start": 21.25,
   "end": 23.63,
   "text": "Jupiter is five times further from the sun than Earth."
  },
  {
   "start": 24.33,
   "end": 28.26,
   "text": "To save fuel, spacecraft fly past Earth or Venus first to pick up speed."
  },
  {
   "start": 28.88,
   "end": 30.54,
   "text": "That way, it takes five to six years."
  },
  {
   "start": 31.07,
   "end": 32.53,
   "text": "Galileo took just over six."
  },
  {
   "start": 33.01,
   "end": 34.15,
   "text": "Juno took just under five."
  },
  {
   "start": 34.7,
   "end": 36.48,
   "text": "So, the moon, a few days."
  },
  {
   "start": 37.12,
   "end": 38.6,
   "text": "Mars, seven to ten months."
  },
  {
   "start": 39.18,
   "end": 40.74,
   "text": "Jupiter, five to six years."
  }
 ]
}