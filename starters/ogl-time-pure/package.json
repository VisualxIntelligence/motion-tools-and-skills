{
  "name": "ogl-time-pure",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OGL (minimal WebGL) starter where every frame is a pure function of time, rendered in headless Chrome",
  "scripts": {
    "sheet": "node render.mjs --sheet=0,1.5,3,4.5,6,7.9 --cols=3 --w=640 --out=out/check/sheet.jpg",
    "stills": "node render.mjs --stills=2,5 --out=out/stills",
    "check": "node test/determinism.mjs",
    "frames": "node render.mjs --frames --workers=4",
    "encode": "node render.mjs --encode --out=out/video.mp4",
    "clip": "node render.mjs --clip --out=out/video.mp4"
  },
  "dependencies": {
    "puppeteer-core": "^25.11.0"
  }
}
